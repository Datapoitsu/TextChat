<Window x:Class="TextChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextChat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="MainPanel">
        <Grid x:Name="mainMenuGrid" Visibility="Collapsed">
            <Button Content="Connect to server" Tag="setUserGrid" Click="OpenWindow" Height="50" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,200"/>
            <Button Content="Server" Height="50" Width="150"/>
            <Button Content="Quit" Click="Quit" Height="50" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,200,0,0" />
        </Grid>
        <Grid x:Name="setUserGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Width="60" Margin="0,0,200,100"><Run Text="Username:"/></TextBlock>
            <TextBox x:Name="UsernameField" HorizontalAlignment="Center" Margin="0,63,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="24" TextChanged="Username_TextChanged"/>
            <Button Content="Back" Tag="mainMenuGrid" Click="OpenWindow" HorizontalAlignment="Left" Margin="0,200,400,0" VerticalAlignment="Top" Width="150" Height="50"/>
            <Button x:Name="UsernameContinue" Tag="setIpGrid" Click="OpenWindow" IsEnabled="False"  Content="Continue" HorizontalAlignment="Center" Margin="400,200,0,0" VerticalAlignment="Center" Width="150" Height="50"/>
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Height="50" Width="300" Margin="145,104,0,0"><Run Text="Username must be atleast 3 characters long and only contain letters or digits."/></TextBlock>
        </Grid>
        <Grid x:Name="setIpGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Width="60" Margin="0,0,200,100"><Run Language="fi-fi" Text="IP address:"/></TextBlock>
            <TextBox x:Name="ipAddressField" HorizontalAlignment="Center" Margin="0,63,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="24" TextChanged="ipAddress_TextChanged"/>
            <Button Content="Back" Tag="setUserGrid" Click="OpenWindow" HorizontalAlignment="Left" Margin="0,200,400,0" VerticalAlignment="Top" Width="150" Height="50"/>
            <Button x:Name="IpContinue" Tag="connectionGrid" Click="OpenWindow" Content="Connect" IsEnabled="False" HorizontalAlignment="Center" Margin="400,200,0,0" VerticalAlignment="Center" Width="150" Height="50"/>
            <TextBlock x:Name="Error" HorizontalAlignment="Left" Margin="145,135,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        </Grid>
        <Grid x:Name="connectionGrid" Visibility="Collapsed">
            <TextBlock x:Name="ConnectionText" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Width="250" Margin="0,0,0,-2" TextAlignment="Center"><Run Text="Trying to connect"/><Run Text=" to the server"/><Run Language="fi-fi" Text=":"/></TextBlock>
            <Button x:Name="CancelConnectionButton" Tag="setIpGrid" Click="OpenWindow" Content="Cancel connection" HorizontalAlignment="Center" Margin="0,250,0,0" VerticalAlignment="Center" Width="150" Height="50"/>
        </Grid>
        <Grid x:Name="setServerName" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Height="24" Width="73" Margin="137,62,0,0"><Run Text="Server name:"/></TextBlock>
            <TextBox x:Name="ServernameField" HorizontalAlignment="Center" Margin="0,62,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="24" TextChanged="Servername_TextChanged"/>
            <Button Content="Back" Tag="mainMenuGrid" Click="OpenWindow" HorizontalAlignment="Left" Margin="0,200,400,0" VerticalAlignment="Top" Width="150" Height="50"/>
            <Button x:Name="ServernameContinue" Tag="ChatWindow" Click="OpenWindow" IsEnabled="False"  Content="Continue" HorizontalAlignment="Center" Margin="400,200,0,0" VerticalAlignment="Center" Width="150" Height="50"/>
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Height="50" Width="300" Margin="145,104,0,0"><Run Language="fi-fi" Text="Server name"/><Run Text=" must be atleast 3 characters long and only contain letters or digits."/></TextBlock>
        </Grid>
        <Grid x:Name="ChatWindow">
            <Button Content="Quit Server" Tag="mainMenuGrid" Click="OpenWindow" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="40" Width="100"/>
            <TextBlock x:Name="chatOutput" HorizontalAlignment="Center" Margin="0,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="329" Width="650" Grid.RowSpan="2" FontSize="24"/>
            <TextBox x:Name="chatInputField" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="650" Height="40" Margin="0,389,0,0" FontSize="24"/>
            <Button Content="Send" Click="SendMessage" HorizontalAlignment="Left" Margin="725,389,0,0" VerticalAlignment="Top" Height="40" Width="63"/>
        </Grid>
    </Grid>
</Window>